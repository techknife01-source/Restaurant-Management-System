{
  "entities": {
    "User": {
      "title": "User",
      "description": "Registered diner profile and preferences",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "phoneNumber": { "type": "string" },
        "role": { "type": "string", "enum": ["customer", "admin", "staff"] },
        "createdAt": { "type": "string" }
      },
      "required": ["uid", "email", "displayName"]
    },
    "Admin": {
      "title": "Admin",
      "description": "Privileged staff / restaurant manager identification",
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "role": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["email", "role"]
    },
    "Reservation": {
      "title": "Reservation",
      "description": "Table booking record for diners",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "customerName": { "type": "string" },
        "customerEmail": { "type": "string" },
        "customerPhone": { "type": "string" },
        "guestsCount": { "type": "number" },
        "bookingDate": { "type": "string" },
        "timeSlot": { "type": "string" },
        "seatingZone": { "type": "string", "enum": ["terrace", "wine_cellar", "main_hall", "chefs_counter"] },
        "tableNumber": { "type": "string" },
        "occasion": { "type": "string", "enum": ["casual", "birthday", "anniversary", "business", "date"] },
        "specialRequests": { "type": "string" },
        "status": { "type": "string", "enum": ["confirmed", "seated", "completed", "cancelled"] },
        "depositAmount": { "type": "number" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "customerName", "customerEmail", "customerPhone", "guestsCount", "bookingDate", "timeSlot", "seatingZone", "status"]
    },
    "Order": {
      "title": "Order",
      "description": "Dine-in and takeaway parcel orders with itemized billing in INR",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "billNumber": { "type": "string" },
        "userId": { "type": "string" },
        "customerName": { "type": "string" },
        "customerEmail": { "type": "string" },
        "customerPhone": { "type": "string" },
        "orderType": { "type": "string", "enum": ["dine_in", "takeaway_parcel", "home_delivery", "room_service"] },
        "tableNumber": { "type": "string" },
        "deliveryAddress": { "type": "string" },
        "items": { "type": "array" },
        "subtotal": { "type": "number" },
        "tax": { "type": "number" },
        "serviceCharge": { "type": "number" },
        "discount": { "type": "number" },
        "tip": { "type": "number" },
        "totalAmount": { "type": "number" },
        "paymentMethod": { "type": "string", "enum": ["pay_now_card", "pay_now_upi", "postpaid_cash", "pay_at_counter"] },
        "paymentStatus": { "type": "string", "enum": ["paid", "pending", "pay_at_counter"] },
        "orderStatus": { "type": "string", "enum": ["placed", "kitchen_preparing", "ready_to_serve", "served_or_dispatched", "completed", "cancelled"] },
        "estimatedMinutes": { "type": "number" },
        "specialInstructions": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "billNumber", "customerName", "orderType", "items", "subtotal", "totalAmount", "paymentMethod", "orderStatus"]
    },
    "RoomBooking": {
      "title": "RoomBooking",
      "description": "Affordable guest room stay reservations (AC / Non-AC from 499 to 999 INR)",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "bookingNumber": { "type": "string" },
        "userId": { "type": "string" },
        "guestName": { "type": "string" },
        "guestEmail": { "type": "string" },
        "guestPhone": { "type": "string" },
        "roomType": { "type": "string", "enum": ["non_ac_standard", "non_ac_deluxe", "ac_executive", "ac_royal_suite"] },
        "roomName": { "type": "string" },
        "roomNumber": { "type": "string" },
        "pricePerNight": { "type": "number" },
        "checkInDate": { "type": "string" },
        "checkOutDate": { "type": "string" },
        "nightsCount": { "type": "number" },
        "guestsCount": { "type": "number" },
        "totalAmount": { "type": "number" },
        "paymentMethod": { "type": "string" },
        "paymentStatus": { "type": "string" },
        "status": { "type": "string", "enum": ["confirmed", "checked_in", "completed", "cancelled"] },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "bookingNumber", "guestName", "roomType", "pricePerNight", "checkInDate", "checkOutDate", "totalAmount", "status"]
    },
    "MenuItem": {
      "title": "MenuItem",
      "description": "Artisanal bistro catalog items including authentic Indian delicacies",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "category": { "type": "string" },
        "price": { "type": "number" },
        "image": { "type": "string" },
        "isVegetarian": { "type": "boolean" },
        "isVegan": { "type": "boolean" },
        "isGlutenFree": { "type": "boolean" },
        "isChefSpecial": { "type": "boolean" },
        "rating": { "type": "number" },
        "prepTime": { "type": "string" },
        "allergens": { "type": "array" },
        "available": { "type": "boolean" }
      },
      "required": ["id", "name", "category", "price", "available"]
    },
    "Review": {
      "title": "Review",
      "description": "Guest ratings and feedback for dining and room stays",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "userAvatar": { "type": "string" },
        "rating": { "type": "number" },
        "category": { "type": "string", "enum": ["dining", "room_stay", "overall"] },
        "itemReviewed": { "type": "string" },
        "title": { "type": "string" },
        "comment": { "type": "string" },
        "stayOrDineDate": { "type": "string" },
        "createdAt": { "type": "string" },
        "likesCount": { "type": "number" },
        "verifiedStayOrDine": { "type": "boolean" }
      },
      "required": ["id", "userName", "rating", "category", "comment", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Profiles for registered customers and bistro staff"
    },
    "/admins/{adminId}": {
      "schema": "Admin",
      "description": "Authoritative list of restaurant admin user IDs"
    },
    "/reservations/{reservationId}": {
      "schema": "Reservation",
      "description": "Table bookings and reservations"
    },
    "/orders/{orderId}": {
      "schema": "Order",
      "description": "Dine-in and parcel food orders with billing state"
    },
    "/room_bookings/{roomBookingId}": {
      "schema": "RoomBooking",
      "description": "Affordable AC and Non-AC room stays"
    },
    "/reviews/{reviewId}": {
      "schema": "Review",
      "description": "Guest reviews and ratings for dining and room stays"
    },
    "/menu_items/{menuItemId}": {
      "schema": "MenuItem",
      "description": "Artisanal bistro catalog items"
    }
  }
}

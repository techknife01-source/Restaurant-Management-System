rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Global security helpers
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        (request.auth.token.email == 'kazi18296@gmail.com' && request.auth.token.email_verified == true) ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidReservation(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.customerName is string && data.customerName.size() > 0 && data.customerName.size() <= 100 &&
             data.customerEmail is string && data.customerEmail.size() <= 120 &&
             data.customerPhone is string && data.customerPhone.size() <= 30 &&
             data.guestsCount is number && data.guestsCount >= 1 && data.guestsCount <= 30 &&
             data.bookingDate is string && data.bookingDate.size() <= 20 &&
             data.timeSlot is string && data.timeSlot.size() <= 20 &&
             data.seatingZone is string && (data.seatingZone in ['terrace', 'wine_cellar', 'main_hall', 'chefs_counter']) &&
             data.status is string && (data.status in ['confirmed', 'seated', 'completed', 'cancelled']);
    }

    function isValidOrder(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.billNumber is string && data.billNumber.size() <= 50 &&
             data.customerName is string && data.customerName.size() > 0 && data.customerName.size() <= 100 &&
             data.orderType is string && (data.orderType in ['dine_in', 'takeaway_parcel', 'home_delivery', 'room_service']) &&
             data.items is list && data.items.size() > 0 && data.items.size() <= 50 &&
             data.subtotal is number && data.subtotal >= 0 &&
             data.totalAmount is number && data.totalAmount >= 0 &&
             data.paymentMethod is string && (data.paymentMethod in ['pay_now_card', 'pay_now_upi', 'postpaid_cash', 'pay_at_counter']) &&
             data.orderStatus is string && (data.orderStatus in ['placed', 'kitchen_preparing', 'ready_to_serve', 'served_or_dispatched', 'completed', 'cancelled']);
    }

    function isValidRoomBooking(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.bookingNumber is string && data.bookingNumber.size() <= 64 &&
             data.guestName is string && data.guestName.size() > 0 && data.guestName.size() <= 100 &&
             data.roomType is string && (data.roomType in ['non_ac_standard', 'non_ac_deluxe', 'ac_executive', 'ac_royal_suite']) &&
             data.pricePerNight is number && data.pricePerNight >= 400 && data.pricePerNight <= 3000 &&
             data.checkInDate is string && data.checkInDate.size() <= 20 &&
             data.checkOutDate is string && data.checkOutDate.size() <= 20 &&
             data.totalAmount is number && data.totalAmount >= 0 &&
             data.status is string && (data.status in ['confirmed', 'checked_in', 'completed', 'cancelled']);
    }

    function isValidReview(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.userName is string && data.userName.size() > 0 && data.userName.size() <= 100 &&
             data.rating is number && data.rating >= 1 && data.rating <= 5 &&
             data.category is string && (data.category in ['dining', 'room_stay', 'overall']) &&
             data.comment is string && data.comment.size() > 0 && data.comment.size() <= 2000 &&
             data.createdAt is string && data.createdAt.size() <= 50;
    }

    // Users Collection
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create, update: if (isOwner(userId) && incoming().role == 'customer') || isAdmin();
      allow delete: if isAdmin();
    }

    // Admins Collection
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Reservations Collection
    match /reservations/{reservationId} {
      allow get: if isValidId(reservationId) && (isAdmin() || (isSignedIn() && existing().userId == request.auth.uid) || existing().userId == 'guest');
      allow list: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isValidId(reservationId) && isValidReservation(incoming()) && (
        isAdmin() ||
        (isSignedIn() && incoming().userId == request.auth.uid) ||
        (!isSignedIn() && incoming().userId == 'guest')
      );
      allow update: if isValidId(reservationId) && isValidReservation(incoming()) && (
        isAdmin() ||
        (isSignedIn() && existing().userId == request.auth.uid && incoming().userId == existing().userId &&
         incoming().diff(existing()).affectedKeys().hasOnly(['status', 'specialRequests']) &&
         incoming().status in ['confirmed', 'cancelled'])
      );
      allow delete: if isValidId(reservationId) && isAdmin();
    }

    // Orders Collection
    match /orders/{orderId} {
      allow get: if isValidId(orderId) && (isAdmin() || (isSignedIn() && existing().userId == request.auth.uid) || existing().userId == 'guest');
      allow list: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isValidId(orderId) && isValidOrder(incoming()) && (
        isAdmin() ||
        (isSignedIn() && incoming().userId == request.auth.uid) ||
        (!isSignedIn() && incoming().userId == 'guest')
      );
      allow update: if isValidId(orderId) && isValidOrder(incoming()) && (
        isAdmin() ||
        (isSignedIn() && existing().userId == request.auth.uid && incoming().userId == existing().userId &&
         incoming().diff(existing()).affectedKeys().hasOnly(['orderStatus', 'specialInstructions']) &&
         incoming().orderStatus in ['placed', 'cancelled'])
      );
      allow delete: if isValidId(orderId) && isAdmin();
    }

    // Room Bookings Collection (Affordable Stays: Non-AC 499-599rs, AC 799-999rs)
    match /room_bookings/{roomBookingId} {
      allow get: if isValidId(roomBookingId) && (isAdmin() || (isSignedIn() && existing().userId == request.auth.uid) || existing().userId == 'guest');
      allow list: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isValidId(roomBookingId) && isValidRoomBooking(incoming()) && (
        isAdmin() ||
        (isSignedIn() && incoming().userId == request.auth.uid) ||
        (!isSignedIn() && incoming().userId == 'guest')
      );
      allow update: if isValidId(roomBookingId) && isValidRoomBooking(incoming()) && (
        isAdmin() ||
        (isSignedIn() && existing().userId == request.auth.uid && incoming().userId == existing().userId &&
         incoming().diff(existing()).affectedKeys().hasOnly(['status']) &&
         incoming().status in ['confirmed', 'cancelled'])
      );
      allow delete: if isValidId(roomBookingId) && isAdmin();
    }

    // Reviews Collection (Guest ratings & feedback for dining and room stays)
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isValidId(reviewId) && isValidReview(incoming()) && (
        isAdmin() ||
        (isSignedIn() && incoming().userId == request.auth.uid) ||
        (!isSignedIn() && incoming().userId == 'guest')
      );
      allow update: if isValidId(reviewId) && isValidReview(incoming()) && (
        isAdmin() ||
        (isSignedIn() && existing().userId == request.auth.uid && incoming().userId == existing().userId &&
         incoming().diff(existing()).affectedKeys().hasOnly(['comment', 'rating', 'title', 'likesCount']))
      );
      allow delete: if isValidId(reviewId) && (isAdmin() || (isSignedIn() && existing().userId == request.auth.uid));
    }

    // Menu Items Collection
    match /menu_items/{menuItemId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
